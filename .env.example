# Frontend repo (public-safe values only)
# Use this when the frontend app is a separate repo from the backend service.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000

# Backend repo / server-side values
# These belong in the backend service or server deployment, not the browser app.
ENABLE_LIVE_INTEGRATION=true
GITHUB_TOKEN=your_github_token_here
GITHUB_OWNER=Usamacodezee
GITHUB_REPO=sixtifi-hrms-software-updates
WEBHOOK_SECRET=your_webhook_secret_here

# If the frontend and backend live in the same repo, keep the same values here and
# use /api/integrations as the default fetch target.
